     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "When ordering a video production from a production company or a freelancer, make a contract with the producer to make sure the rights to use and distribute the video are transferred to Aalto University. Sign the contracts before the production begins.",
       "spans": [
        {
         "start": 123,
         "end": 165,
         "type": "strong"
        }
       ],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "You also need a written permission from the people presented on the video (the ‘models’).",
       "spans": [],
       "direction": "ltr"
      }
     ],
     "component_id": null,
