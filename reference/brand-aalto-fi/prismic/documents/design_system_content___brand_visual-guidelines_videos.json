   {
    "primary": {
     "type": "TextChapter",
     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "The preferred video resolution is UHD (3840 x 2160 pixels). This is the Marsio Stage and Cinema screen resolution. Marsio is our main venue for events and our best videos could be showcased there. Material in UHD resolution can also be easily cropped into portrait video for social media channels if needed.",
       "spans": [
        {
         "start": 34,
         "end": 58,
         "type": "strong"
        }
       ],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "For social media channels mainly consumed with a mobile phone, consider delivering the video in vertical format (resolution 1080 x 1920) or a square (1080 x 1080). Please contact our social media manager through communications@aalto.fi for further information.",
       "spans": [],
       "direction": "ltr"
      }
     ],
     "component_id": null,
     "component_figma_link": {
