   },
   {
    "primary": {
     "type": "TextChapter",
     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "The animated Aalto logo can be used at the end of videos related to Aalto University. You can either use it as it is, or use the white logo on top of the video image. If an image is used as background to the logo, it should be sufficiently calm and even in tone for the logo to be clearly visible.",
       "spans": [],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "Note: Always use the logo originals. The Aalto University logos are registered trademarks, and altering them is not allowed.",
       "spans": [],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "",
       "spans": [],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "Follow general visual guidelines on all graphics in your video.",
       "spans": [],
       "direction": "ltr"
      }
     ],
     "component_id": null,
