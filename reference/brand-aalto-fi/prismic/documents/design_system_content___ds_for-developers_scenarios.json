     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Currently, the React implementation of the design system library is the most mature one. Unlike plain HTML/CSS, React components are fully functional, making them more readily usable in your projects. Especially when you're implementing a new channel without pre-existing technological constraints, employing React is most likely the most straightforward path to fully leverage the design system's benefits.",
       "spans": [],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "Most web-based channels can be constructed using the UI elements available in @aalto-dx/react-components. To install the package, execute the following command in the project's root directory (where the package.json file is located):",
       "spans": [
        {
         "start": 78,
         "end": 104,
         "type": "strong"
        }
       ],
       "direction": "ltr"
      }
     ],
     "component_id": null,
     "component_figma_link": {
      "link_type": "Any"
     },
     "plain_component_preview": false,
     "react_code_preview": false,
     "code_language": null,
     "button_label": [],
     "button_link": {
      "link_type": "Any"
     },
     "alignment": "left",
     "aside": {
      "link_type": "Document"
     },
     "hidden": false,
     "theme": "neutral",
     "tinted": false,
     "video_source": {
      "link_type": "Any"
     },
     "anchor": false
    },
