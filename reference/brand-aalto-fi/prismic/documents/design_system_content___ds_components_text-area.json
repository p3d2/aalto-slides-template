      {
       "type": "paragraph",
       "text": "Text Area is used when the expected answer is more than a single line of text. It is mostly used in open-ended questions in forms.",
       "spans": []
      },
      {
       "type": "paragraph",
       "text": "Text Area is not used for answers shorter than a single line of text, such as a name or a phone number. For single-line inputs, Text Input is used instead.",
