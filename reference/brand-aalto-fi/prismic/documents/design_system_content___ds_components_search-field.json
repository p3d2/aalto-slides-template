    "primary": {
     "type": "TextChapter",
     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Search Field is a UI component that includes a text input box, a search button, and optionally, a dropdown list displaying predefined options or previous search results.",
       "spans": []
      },
      {
       "type": "paragraph",
       "text": "Search Field component focuses solely on the user interface aspect of search functionality. The process of querying data, such as retrieving information from a database or content management system, is implemented separately. Ideally, a continuous search should be implemented, where the results are updated dynamically as the user types into the input field. However, in some cases, immediate updating may not be feasible due to specific environmental constraints. In such situations, clicking the search button will trigger a fresh search and retrieve the most up-to-date results.",
       "spans": []
      }
