     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Snackbars display short messages at the bottom of the screen. They inform users of things that happened or are about to happen. They will disappear on their own and do not require the user to close or dismiss them. However, they can contain an action. Only one Snackbar is visible at a time. ",
       "spans": []
      }
