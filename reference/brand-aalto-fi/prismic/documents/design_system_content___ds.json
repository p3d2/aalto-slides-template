       "type": "heading6",
       "text": "Join the Design system Teams community",
       "spans": [],
       "direction": "ltr"
      }
     ],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Ask questions, give comments, propose new components or share learnings of using the design system. The community is open for all design system users: Aalto students, staff or partners. If you don't have an Aalto ID, and you need access, please write an email to communications@aalto.fi.",
       "spans": [],
       "direction": "ltr"
