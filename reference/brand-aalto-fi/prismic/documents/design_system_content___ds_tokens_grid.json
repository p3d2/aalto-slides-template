   },
   {
    "primary": {
     "type": "TextChapter",
     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Organising visual content in a grid is essential to establishing a sense of structure and organisation for any layout. While the final decisions always remain in the hands of the designer, the Aalto design system provides an array of tools and assets that make it easy to create consistent, responsive layouts for any digital medium. In addition to enhancing the aesthetic quality of your design, adhering to set layout rules helps ensure compliance with accessibility standards and fundamental principles of good user interface design.",
       "spans": []
      }
     ],
     "component_id": null,
     "component_figma_link": {
      "link_type": "Any"
     },
     "plain_component_preview": false,
     "react_code_preview": false,
     "code_language": null,
     "button_label": [],
