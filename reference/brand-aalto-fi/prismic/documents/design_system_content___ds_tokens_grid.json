   {
    "primary": {
     "title": [
      {
       "type": "heading2",
       "text": "Breakpoints",
       "spans": []
      }
     ],
     "ingress_title": [],
     "body": [
      {
       "type": "paragraph",
       "text": "Breakpoints enable the adaptation of digital content display in response to a user's device viewport size, allowing for adjustments for example in layout, typography, or the visibility of individual visual elements. The Breakpoint design tokens in the Aalto design system offer an efficient means of delivering responsive design across diverse screen sizes and device types.",
       "spans": []
      }
     ],
     "tier": "base",
