     "anchor": false
    },
    "items": [
     {}
    ],
    "id": "page_section_element$d0d87985-6f10-4272-adeb-ea60e8d70928",
    "slice_type": "page_section_element",
    "slice_label": null
   },
   {
    "primary": {
     "title": [
      {
       "type": "heading2",
       "text": "Dimensions",
       "spans": []
      }
     ],
     "ingress_title": [],
     "body": [
      {
       "type": "paragraph",
       "text": "The foundation of the Aalto design system grid is the 1 rem / 16 px unit. Ideally, most content should be arranged using a 1rem x 1rem grid, including visual item sizes and negative space. However, in some instances, smaller distances may be necessary and the Aalto design system thus provides a set of tokens to accommodate those needs as well.",
       "spans": []
      }
     ],
     "tier": "base",
     "group": "dimension",
     "variable_map": null,
     "typography_placeholder": [],
     "item_prefix": [
      {
