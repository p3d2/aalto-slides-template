         "start": 90,
         "end": 99,
         "type": "hyperlink",
         "data": {
          "link_type": "Web",
          "url": "https://storybook.js.org/",
          "target": "_blank"
         }
        }
       ],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "Currently, the following Storybooks are provided:\nReact Components",
