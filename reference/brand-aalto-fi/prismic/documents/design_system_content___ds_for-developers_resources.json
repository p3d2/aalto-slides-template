     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Aalto University’s primary typeface is Inter:\nDownload Inter",
       "spans": [
        {
         "start": 46,
         "end": 60,
         "type": "hyperlink",
         "data": {
          "link_type": "Web",
          "url": "https://rsms.me/inter/download/",
          "target": "_new"
         }
        }
       ],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "For web development however, it is often more efficient to import the font directly from Google Fonts in the head of your page, rather than downloading it:",
       "spans": [
        {
         "start": 109,
         "end": 113,
         "type": "em"
