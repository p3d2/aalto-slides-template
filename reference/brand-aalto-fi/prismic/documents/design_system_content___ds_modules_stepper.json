     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Stepper visually represents the steps of a multi-step process or workflow. It guides users through a sequence of steps or stages, helping them understand their current position within the process and what steps remain.",
       "spans": [],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "Each step is represented as a node, often accompanied by a label, and these nodes are connected by lines to indicate progression. Completed steps feature a checkmark, current steps are highlighted, and future steps are outlined but inactive. This visual progression aids in setting expectations and providing feedback about the user's journey through the process.",
       "spans": [],
       "direction": "ltr"
      }
     ],
     "component_id": null,
     "component_figma_link": {
      "link_type": "Any"
     },
