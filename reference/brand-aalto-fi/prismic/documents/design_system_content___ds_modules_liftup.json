     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Use Liftup when the content leads to a non-navigational action such as downloading a file, opening a document, or triggering a tool. Unlike the Card, only the link or button is interactive, supporting focused user engagement.",
