     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Colours are used by their semantic names to simplify colour selection and usage. These names signify the intended use of the colours and act as guides when building a product. While building there is no need to concentrate on colour values or themes but rather choosing the correct name for the use case.",
       "spans": []
      },
      {
       "type": "paragraph",
       "text": "There are a total of 16 colours divided into three groups. These groups are Basic, Action and Action Reversed.",
       "spans": []
      }
     ],
     "component_id": null,
     "component_figma_link": {
