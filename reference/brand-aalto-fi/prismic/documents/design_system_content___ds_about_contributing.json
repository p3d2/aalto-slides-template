    "primary": {
     "body_text": [
      {
       "type": "paragraph",
       "text": "The Aalto design system is a collaborative effort, and we encourage you to actively participate and contribute to its growth. Share your feedback, suggestions, and ideas for improving the design system with our dedicated design team. By collaborating, we can collectively enhance the system, address any challenges, and continuously improve the overall design experience.",
       "spans": []
      },
      {
       "type": "paragraph",
       "text": "To contribute, contact our design system team for more information.",
       "spans": []
      }
     ],
