      },
      "title": [
       {
        "type": "heading6",
        "text": "We are trustworthy in order to make people well informed",
        "spans": []
       }
      ],
      "body_text": [
       {
        "type": "paragraph",
        "text": "Honesty, responsibility, and reliability should be seen in our communication. We articulate our intentions clearly and back them up with fact-based, up-to-date, and transparent content. Washing in any colour, be it green, blue, pink, or white, is a no-go. This way we fulfill the audience’s need to know.",
        "spans": []
       }
