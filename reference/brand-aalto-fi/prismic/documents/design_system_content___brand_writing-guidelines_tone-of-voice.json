      },
      "title": [
       {
        "type": "heading6",
        "text": "We are courageous in order to make people feel empowered",
        "spans": []
       }
      ],
      "body_text": [
       {
        "type": "paragraph",
        "text": "We proudly share our successes and are ready to offer solutions to major societal challenges. We are not afraid of taking a stand. We say what we think but never in an arrogant way. For example, we use fewer qualifiers like “possibly” and “maybe” and avoid ambiguity.",
        "spans": []
       }
      ],
