   {
    "primary": {
     "type": "TextChapter",
     "page_section_element_title": [
      {
       "type": "heading6",
       "text": "Right of access and right to rectification",
       "spans": [],
       "direction": "ltr"
      }
     ],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "You have the right to receive confirmation on whether we process personal data relating to you and the right to access any such personal data. Aalto may ask you to specify your request where necessary, for example with regard to the details of the provision of information.",
       "spans": [],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "In addition, you have the right to request the rectification of incorrect personal data relating to you, or to supplement incomplete personal data Aalto is processing.",
       "spans": [],
       "direction": "ltr"
      }
     ],
     "component_id": null,
     "component_figma_link": {
