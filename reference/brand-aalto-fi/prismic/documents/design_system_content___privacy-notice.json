     "type": "TextChapter",
     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "You can use your rights by contacting Aalto's data protection officer at tietosuojavastaava(at)aalto.fi. The extent of your rights is subject to the legal basis for processing and exercising your rights requires identification.",
