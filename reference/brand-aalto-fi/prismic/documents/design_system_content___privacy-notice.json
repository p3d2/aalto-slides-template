     "type": "TextChapter",
     "page_section_element_title": [
      {
       "type": "heading6",
       "text": "Right to data portability",
       "spans": [],
       "direction": "ltr"
      }
     ],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "You have the right to receive your personal data from us in a structured, commonly used format so that you may transfer your personal data to another controller, provided that the processing of your personal data is based on consent or a contract between you and Aalto.",
