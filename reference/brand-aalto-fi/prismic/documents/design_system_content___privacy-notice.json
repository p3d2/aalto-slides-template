   {
    "primary": {
     "type": "TextChapter",
     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Aalto University (“Aalto”) collects personal data that relates to the users of the brand.aalto.fi website (“website”). This privacy notice applies to the website brand.aalto.fi. Aalto acts as the controller for personal data that users of the website provide when they visit the website or by other means or that is collected automatically in conjunction with website browsing activity.",
       "spans": [],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "Protecting your privacy and your personal data is of the utmost importance to us. Aalto is committed to complying with the requirements that data protection regulation places upon Aalto in the processing of your personal data.",
       "spans": [],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "The means and purposes of processing your personal data are described in further detail in this privacy notice.",
       "spans": [],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "This privacy notice is subject to change. You will always find the up-to-date version of this privacy notice on this website.",
       "spans": [],
       "direction": "ltr"
      }
     ],
