   {
    "primary": {
     "type": "TextChapter",
     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "The General Data Protection Regulation grants the data subject a number of rights with which the data subject can govern the processing of their personal data. The data subject may use the following rights in relation to Aalto insofar as Aalto acts as the controller for the data subject’s personal data:",
       "spans": [],
