   {
    "primary": {
     "type": "TextChapter",
     "page_section_element_title": [
      {
       "type": "heading6",
       "text": "Right to object",
       "spans": [],
       "direction": "ltr"
      }
     ],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "You also have the right to object to the processing of your personal data if your personal data is processed for other purposes than the fulfillment of legal responsibilities or the provision of services. You may object to the processing of your personal data for purposes of direct marketing, even if the basis for such processing is consent given by you in the past. Objecting to the processing of your personal data may lead to limitation of the usage of Aalto website. You have the right to prohibit direct marketing by following the instructions contained in all of our marketing messages.",
       "spans": [],
       "direction": "ltr"
      }
     ],
     "component_id": null,
     "component_figma_link": {
