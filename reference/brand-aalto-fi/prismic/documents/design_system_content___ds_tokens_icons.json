     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "The Aalto design system offers a fundamental collection of icons that are well-suited for any digital user interface and specifically designed to work together with the other Aalto design elements, such as typography and colour. Consistently using these recognisable icons across various digital channels helps create a seamless and intuitive user experience that aligns with the brand.",
       "spans": []
      }
     ],
     "component_id": null,
     "component_figma_link": {
