     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "While both of these broad areas of visual representation are very much informed by the visual identity of the university it is not feasible to limit their exact form. However, it is recommended that only colours and typefaces belonging to the visual identity of Aalto University are used and that the work is marked or deputized by an appropriate logo to give context.",
       "spans": []
      }
