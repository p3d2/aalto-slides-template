      {
       "type": "paragraph",
       "text": "Aalto Design system currently uses custom fonts that must be installed locally on the computer if the texts are edited in Figma. Aalto University’s primary typeface is Inter from Google Fonts.",
       "spans": [],
       "direction": "ltr"
      },
