     "page_section_element_title": [],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Animated graphics, videos, and other dynamic elements are integral to the Aalto design language. User interfaces may also include animated transitions and micro-interactions. However, it is essential to use motion thoughtfully to prevent distracting the user's attention from the primary content.",
       "spans": []
      }
     ],
