   {
    "primary": {
     "title": [
      {
       "type": "heading2",
       "text": "Transition",
       "spans": []
      }
     ],
     "ingress_title": [],
     "body": [
      {
       "type": "paragraph",
       "text": "Transition tokens should be used to define the duration of short animations like mouse-over effects. There is no one-size-fits-all solution, and designers should consider both the desired impact and the size of the movement when selecting the appropriate duration.",
       "spans": []
      }
     ],
     "tier": "base",
