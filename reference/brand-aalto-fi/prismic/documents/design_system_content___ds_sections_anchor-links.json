   {
    "primary": {
     "type": "TextChapter",
     "page_section_element_title": [
      {
       "type": "heading6",
       "text": " ",
       "spans": []
      }
     ],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Anchor Links are most useful with long-form articles, where swiftly accessing specific sections is beneficial and would require an extensive amount of scrolling. In addition to their linking functionality, Anchor Links serve as a helpful table of contents, contributing to improved content comprehension by offering a visual representation of a page's structure and organisation.",
       "spans": []
      },
      {
       "type": "paragraph",
       "text": "The horizontal variant is the preferred one. However, the vertical layout is used if the anchor labels are longer than a couple of words.",
       "spans": []
      },
      {
       "type": "paragraph",
       "text": "In the majority of cases, it is advisable for Anchor Links to remain fixed at the top of a page, even when scrolling beyond their initial position. There are instances where this sticky behavior may not be feasible though, such as when the viewport size is limited.",
       "spans": []
      }
     ],
