     ],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "The Aalto website largely meets the requirements for accessibility. The website requires further improvements, however, in the following areas:",
       "spans": []
      },
      {
       "type": "paragraph",
       "text": "- image descriptions (alt texts)",
       "spans": []
