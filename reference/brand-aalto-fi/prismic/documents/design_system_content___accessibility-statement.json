      {
       "type": "heading6",
       "text": "Did you find an accessibility issue on our website?",
       "spans": []
      }
     ],
     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "If you notice any deficiencies regarding the accessibility of the site, you can provide feedback to: aaltofi-feedback@aalto.fi\nWe will respond to your feedback within two weeks, at the latest. We are actively working to address the accessibility issues that have been identified.",
