     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Use List to organise related content such as navigation links, grouped references, or supporting details. Lists can be flat or nested, with indentation indicating hierarchy. Avoid excessive nesting to preserve clarity.",
       "spans": [],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "List is best suited for relatively simple content that fits within a single column. For more structured or detailed information, consider using a Table or Directory. For interactive or collapsible navigation, see Navigation accordion.",
