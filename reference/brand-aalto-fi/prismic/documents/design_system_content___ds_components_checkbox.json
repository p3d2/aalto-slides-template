     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "Checkboxes typically form Checkbox groups. An exception to this is checkboxes that are used to give consent and confirm choices, for example when agreeing to terms and conditions. ",
       "spans": [
        {
         "start": 26,
         "end": 41,
         "type": "hyperlink",
         "data": {
          "id": "ZEZYbRQAACUAsY3R",
          "type": "design_system_content",
          "tags": [],
          "lang": "en-eu",
          "slug": "checkbox-group",
          "first_publication_date": "2023-04-24T10:24:09+0000",
          "last_publication_date": "2024-08-16T08:47:30+0000",
          "uid": "_ds_components_checkbox-group",
          "link_type": "Document",
          "isBroken": false
         }
        }
       ],
       "direction": "ltr"
      },
      {
       "type": "paragraph",
       "text": "Checkboxes should not be used when only one of the many options can be selected. In such cases, a radio group is usually a more fitting choice.",
       "spans": [
