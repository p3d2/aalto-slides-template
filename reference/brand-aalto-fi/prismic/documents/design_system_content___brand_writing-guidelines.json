     "page_section_element_body": [
      {
       "type": "paragraph",
       "text": "We craft consistent and compelling content that is easy to read. We want to be understandable by our multiple different target groups, faculty and staff, global academic community, students, applicants, alumni, donors, media and general public.\nDetailed writing guidelines, including spelling instructions, can be found in aalto.fi through the links below.",
       "spans": [],
       "direction": "ltr"
