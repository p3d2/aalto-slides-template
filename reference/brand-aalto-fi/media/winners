<script>
toastr.options = {
  positionClass: 'toast-bottom-center',  
};

$(document).ready(function() {
    $('.dropdown-toggle').click(function(e) {
        e.preventDefault();
    });

    // Show the loading overlay and spinner when an AJAX request starts
    $(document).ajaxStart(function() {
        $('#loading-overlay').show();
    });

    // Hide the loading overlay and spinner when an AJAX request finishes
    $(document).ajaxStop(function() {
        $('#loading-overlay').hide();
    });
    
});
</script>
<script>
    var currentPage = 1;
    var selYear = "";
    var selCategory = "";
    var selAward = "";
    var selCountry = "";
    var selAgency = "";
    var subItems = [];

    // Function to get URL parameters
    function getUrlParams() {
        const params = new URLSearchParams(window.location.search);
        return {
            year: params.get('year') || '0',
            category: params.get('category') || '0',
            award: params.get('award') || '0',
            country: params.get('country') || '0',
            agency: params.get('agency') || ''
        };
    }

    // Function to update URL with current filter values
    function updateUrl() {
        const params = new URLSearchParams();
        
        const year = $('#year').val();
        const category = $('#category').val();
        const award = $('#award').val();
        const country = $('#country').val();
        const agency = $('#agency').val();

        if (year && year !== '0') params.set('year', year);
        if (category && category !== '0') params.set('category', category);
        if (award && award !== '0') params.set('award', award);
        if (country && country !== '0') params.set('country', country);
        if (agency && agency.trim() !== '') params.set('agency', agency.trim());

        const newUrl = params.toString() ? 
            window.location.pathname + '?' + params.toString() : 
            window.location.pathname;
        
        window.history.pushState({}, '', newUrl);
    }

    // Function to set form values from URL parameters
    function setFormValuesFromUrl() {
        const params = getUrlParams();
        
        $('#year').val(params.year);
        $('#category').val(params.category);
        $('#award').val(params.award);
        $('#country').val(params.country);
        $('#agency').val(params.agency);
    }
    
    $('.list-input').change( function() {
        currentPage = 1;
        $(".winners-results").html('');
        subItems = [];
        updateUrl();
        loadResults();
    });

    $('#btn-loadMore').click( function() {
        currentPage++;
        loadResults();                 
    });

    $( document ).ready(function() {
        // Set form values from URL parameters on page load
        setFormValuesFromUrl();
        
        loadResults();

        function checkScrollPosition() {
            var scrollPosition = $(window).scrollTop();
            var documentHeight = $(document).height();
            var windowHeight = $(window).height();
            var bottomDistance = documentHeight - windowHeight - scrollPosition;
            var threshold = 0;

            if (bottomDistance <= threshold) {
                currentPage++;
                loadResults();                 
            }
        }
        
        $(window).on('scroll touchmove', function() {
            checkScrollPosition();
        });

        // Handle browser back/forward buttons
        $(window).on('popstate', function() {
            setFormValuesFromUrl();
            currentPage = 1;
            $(".winners-results").html('');
            subItems = [];
            loadResults();
        });
        
    });
    
    function loadResults() {

        var formData = new FormData($("#form-search")[0]);
        formData.append('currentPage', currentPage);
        formData.append('_token', 'dx3U8fkPVEDNLmCKgZYp9CDnnRvHwQcnLNhy9YaK');

        var prev_id = "";

        console.log( $('#award').val() );


        if ( $('#award').val() !== "1890") {
            $.ajax({
                url: "https://awards.europeandesign.org/srv/loadWinners",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function(data) {

                    jsonResult = JSON.parse(data);

                    console.log(jsonResult);

                    

                    for (var i = 0; i < jsonResult.rows.length; i++) {

                        // if (jsonResult.rows[i].agency) {
                        var itemHTML = $('#list-item-copy').html();                    
                        var submission_id = jsonResult.rows[i].submission_id;
                        var title = jsonResult.rows[i].title;
                        var year = jsonResult.rows[i].submission_year;
                        var category = jsonResult.rows[i].submission_category;
                        var award = jsonResult.rows[i].submission_award;
                        var agency_name = jsonResult.rows[i].agency_name;
                        var agency_country = jsonResult.rows[i].agency_country;
                        var submission_photo = (jsonResult.rows[i].photo === null) ? "" : jsonResult.rows[i].photo.submission_photo;

                        itemHTML = itemHTML.replace("|ID|", submission_id);
                        itemHTML = itemHTML.replace("|SUBMISSION_NAME|", title);
                        itemHTML = itemHTML.replace("|YEAR|", year);
                        itemHTML = itemHTML.replace("|CATEGORY|", category);
                        itemHTML = itemHTML.replace("|AWARD_TITLE|", award);
                        itemHTML = itemHTML.replace("|AGENCY_NAME|", agency_name);
                        itemHTML = itemHTML.replace("|COUNTRY|", agency_country);
                        itemHTML = itemHTML.replace("|SUBMISSION_PHOTO|", submission_photo);

                        
                        // if (prev_id != submission_id) {
                        if (subItems.indexOf(submission_id) === -1) {
                            $(".winners-results").append(itemHTML);
                        }

                        subItems.push(submission_id);

                        // prev_id = submission_id;
                        // }
                        
                    }
                    
                },
                error: function(jqXHR, textStatus, errorThrown) {
                    toastr.error("There was an unknown error. Please try again later");
                }
            });
        } else {
            $.ajax({
                url: "https://awards.europeandesign.org/srv/loadAgencies",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function(data) {

                    // jsonResult = JSON.parse(data);
                    console.log(data);

                    try {
                        var jsonResult = JSON.parse(data);

                        for (var i = 0; i < jsonResult.length; i++) {


                            var itemHTML = $('#agency-list-item-copy').html();
                            var agency_id = jsonResult[i].agency_id;
                            var agency_name = jsonResult[i].title;
                            var year = jsonResult[i].year;

                            itemHTML = itemHTML.replace("|ID|", agency_id);
                            itemHTML = itemHTML.replace("|AGENCY_NAME|", agency_name);
                            itemHTML = itemHTML.replace("|AGENCY_PHOTO|", '/img/aoty/' + year + '.jpg');
                            var yearMapping = {
                                6982: 2025,
                                6981: 2024,
                                6980: 2023,
                                6979: 2022,
                                6978: 2021,
                                6564: 2020,
                                6078: 2019,
                                5686: 2018,
                                5295: 2017,
                                4877: 2016,
                                4317: 2015,
                                3817: 2014,
                                3165: 2013,
                                1284: 2012,
                                1283: 2011,
                                1282: 2010,
                                1281: 2009,
                                1280: 2008,
                                1279: 2007
                            };

                            var mappedYear = yearMapping[year] || year; // Default to original year if not found in mapping
                            itemHTML = itemHTML.replace("|YEAR|", mappedYear);
                            
                            $(".winners-results").append(itemHTML);
                            
                            // console.log("ID: " + jsonResult[i].id);
                            // console.log("Year: " + jsonResult[i].year);
                            // console.log("Agency ID: " + jsonResult[i].agency_id);
                            // console.log("Title: " + jsonResult[i].title);
                            // console.log("Description: " + jsonResult[i].description);
                            // console.log("URL: " + jsonResult[i].url);
                            // console.log("Active: " + jsonResult[i].active);
                        }
                    } catch (error) {
                        console.error("Failed to parse JSON response:", error);
                        console.error("Response data:", data);
                    }

                    
                    // console.log(jsonResult);
                }
            });
        }
        
    }

    document.getElementById('form-search').addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            $('#agency').trigger('change');
            loadResults();
        }
    });

</script>
