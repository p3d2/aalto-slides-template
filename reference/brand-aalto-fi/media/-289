    const el = jQuery(this);
    const button = el.find('.image-block__play-btn');
    const src = el.data('src');
    const video = '<video controls><source src="' + src + '" type="video/mp4"></video>'

    button.on('click', function (e) {
      e.preventDefault();
      const hasVideo = el.find('video');
      if(!hasVideo.length)
      {
	      el.find('.image-block__image').append(video);
      };
      const player = el.find('video');
      el.addClass('active');
      player[0].play();
    });
  })
}
