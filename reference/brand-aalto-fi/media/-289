function initTickers() {
  let tickers = document.querySelectorAll('.ticker-list:not(.running)');

  if (tickers.length === 0) return;

  tickers.forEach((item) => {
    const ticker = item;
    const tickerItem = ticker.querySelector('.ticker-list__item');
    let tickerWidth = ticker.offsetWidth;
    let tickerItemWidth = tickerItem.offsetWidth;

    if (tickerWidth < 10 || tickerItemWidth < 10) return;

    let speedX = 0.5;
    let positionX = 0;

    function calculateItemCount(itemWidth, listWidth) {
      let result;

      if (listWidth) {
        result = Math.ceil(Math.abs(window.innerWidth - listWidth) / itemWidth);
      } else {
        result = Math.ceil(window.innerWidth / itemWidth);
      }

      return result;
    }

    function addCloneItems() {
      for (let index = 0; index < calculateItemCount(tickerItemWidth); index++) {
        let clone = tickerItem.cloneNode(true);
        ticker.appendChild(clone);
      }
    }

    function recalculateCloneItems() {
      if (tickerWidth < window.innerWidth + tickerItemWidth) {
        let addCounter = calculateItemCount(tickerItemWidth, tickerWidth);
        for (let index = 0; index < addCounter + 1; index++) {
          let clone = tickerItem.cloneNode(true);
          ticker.appendChild(clone);
        }
      }
    }

    function step() {
      positionX = positionX + speedX;
      if (positionX >= tickerItemWidth || positionX < 0) {
        positionX = 0;
      }

      ticker.style.marginLeft = -positionX + 'px';

      requestAnimationFrame(step);
    }

    const resizeHandler = () => {
      tickerWidth = ticker.offsetWidth;
      tickerItemWidth = tickerItem.offsetWidth;

      if (tickerWidth < 10 || tickerItemWidth < 10) {
        return;
      } else {
        recalculateCloneItems();
      }
    };

    addCloneItems();
    requestAnimationFrame(step);
    window.addEventListener('resize', resizeHandler);

    ticker.addEventListener('mouseenter', () => {
      speedX = 0.2;
    });

    ticker.addEventListener('mouseleave', () => {
      speedX = 0.5;
    });
  });
}
