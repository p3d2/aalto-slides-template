jQuery(document).ready(function($) {
    // 1. Hamburger Menu Accessibility & Focus Trap
    const $btn = $('.nav-opener');
    const $html = $('html');
    const $nav = $('#main-nav');
    
    function toggleMenuState() {
        const isOpen = $html.hasClass('nav-active') || $('body').hasClass('nav-active');
        $btn.attr('aria-expanded', isOpen ? 'true' : 'false');
        if (isOpen) {
            setTimeout(function() {
                $nav.find('a, button, [tabindex="0"]').first().focus();
            }, 150);
        } else {
            $btn.focus();
        }
    }
    
    $btn.on('click', function() {
        setTimeout(toggleMenuState, 50);
    });
    
    $(document).on('keydown', function(e) {
        const isOpen = $html.hasClass('nav-active') || $('body').hasClass('nav-active');
        if (!isOpen) {
            return;
        }

        if (e.key === 'Escape') {
            $btn.click();
            e.preventDefault();
            return;
        }

        if (e.key === 'Tab') {
            const $focusable = $nav.find('a, button, [tabindex="0"]').add($btn);
            if ($focusable.length === 0) return;

            const firstEl = $focusable.get(0);
            const lastEl = $focusable.get($focusable.length - 1);

            if (e.shiftKey) {
                if (document.activeElement === firstEl) {
                    lastEl.focus();
                    e.preventDefault();
                }
            } else {
                if (document.activeElement === lastEl) {
                    firstEl.focus();
                    e.preventDefault();
                }
            }
        }
    });

    // 2. Judge Popups Accessibility
    let activeOpener = null;

    $(document).on('click', '.judge-card', function() {
        activeOpener = this;
        $(this).attr('aria-expanded', 'true');
    });

    $(document).on('afterShow.fb', function(e, instance, current) {
        const $popup = current.$content;
        if ($popup && $popup.length && ($popup.hasClass('judge-popup-wrapper') || $popup.find('.judge-popup').length)) {
            $popup.attr({
                'role': 'dialog',
                'aria-modal': 'true'
            });
            
            const focusableElements = $popup.find('a, button, input, textarea, [tabindex="0"]').filter(':visible');
            if (focusableElements.length) {
                const firstFocusable = focusableElements.first();
                const lastFocusable = focusableElements.last();
                
                const $closeBtn = $popup.find('.judge-popup__close');
                if ($closeBtn.length) {
                    $closeBtn.focus();
                } else {
                    firstFocusable.focus();
                }
                
                $popup.off('keydown.trap').on('keydown.trap', function(evt) {
                    if (evt.key === 'Tab') {
                        if (evt.shiftKey) { // Shift + Tab
                            if (document.activeElement === firstFocusable[0]) {
                                lastFocusable.focus();
                                evt.preventDefault();
                            }
                        } else { // Tab
                            if (document.activeElement === lastFocusable[0]) {
                                firstFocusable.focus();
                                evt.preventDefault();
                            }
                        }
                    }
                });
            }
        }
    });
    
    $(document).on('afterClose.fb', function(e, instance, current) {
        if (activeOpener) {
            $(activeOpener).attr('aria-expanded', 'false').focus();
            activeOpener = null;
        }
    });
});
