<style>
/* Skip link style */
.skip-link {
    position: absolute;
    top: -100px;
    left: 15px;
    background: #f69a77;
    color: #fff;
    padding: 10px 20px;
    z-index: 100000;
    transition: top 0.2s;
    font-weight: bold;
    border-radius: 0 0 5px 5px;
    text-transform: uppercase;
}
.skip-link:focus {
    top: 0;
    outline: 3px solid #fcc311;
}
/* Reset button default styles for nav-opener */
button.nav-opener {
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
}
button.nav-opener:focus-visible {
    outline: 3px solid #fcc311;
    outline-offset: 3px;
}
/* Reset button default styles for play-btn and openers */
button.play-btn,
button.gallery-intro__opener,
button.gallery-intro__close,
button.js-opener,
button.gallery-filter__opener,
button.js-sub-opener,
button.opener {
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
}
button.play-btn:focus-visible,
button.gallery-intro__opener:focus-visible,
button.gallery-intro__close:focus-visible,
button.js-opener:focus-visible,
button.gallery-filter__opener:focus-visible,
button.js-sub-opener:focus-visible,
button.opener:focus-visible {
    outline: 3px solid #fcc311;
    outline-offset: 3px;
}
.section-heading--sm .text-holder { max-width: 725px; }
button.foot-submit-btn {
    margin-left: 0px;
    display: inline-block;
    vertical-align: top;
    background-color: #f69a77;
    padding: 9px 20px;
    color: #fff;
    font-size: 12px;
    line-height: 1.25;
    font-weight: 400;
    text-transform: uppercase;
    border-radius: 20px;
    font-size: 18px;
    /* padding: 12px 29px; */
    line-height: .789;
    min-width: 70px;
    position: relative;
    top: -2px;
}
#menu-social span i { display:none; }
ul#menu-main li a { text-transform:uppercase;}
ul#menu-main li.active a { color:#f79b77; }
.intro-section .h2,h1,h2,.rm-h2 { line-height:1.0; }
.border-list__item { line-height:0.9; }
.intro-slider .slick-dots button { opacity:0.4; border:none; border-radius:0; width:35px; height:2px;}
.intro-slider .slick-dots .slick-active button { opacity:1.0; background-color:#fff; }
.arrow-link:hover:after { transform: none; left: 0px; }
.lt-green:before {background-color:#A6CE39;}
.tan:before {background-color:#BD975E;}
.white:before {background-color:#FFF;}
.beige:before {background-color:#F9E3B2;}
.drk-green:before {background-color:#5B7B45;}
.salmon:before {background-color:#F79A78;}
.pink:before {background-color:#D6BFBB;}
.header-top__text a:hover { text-decoration:none; }

.header-top__text a:hover:before {
    transform: scaleX(1);
}
.header-top__text a:before {
    transition: transform .35s cubic-bezier(.3,.86,.36,.95);
    content: "";
    width: 100%;
    position: absolute;
    left: 0;
    bottom: 0px;
    height: 1px;
    background-color: #f69a77;
    transform: scaleX(0);
}
.announcement-card__title { position:relative; }
.announcement-list__item a:hover .announcement-card__title:before {
    transform: scaleX(1);
}
.announcement-list__item a .announcement-card__title:before {
    transition: transform .35s cubic-bezier(.3,.86,.36,.95);
    content: "";
    width: 100%;
    position: absolute;
    left: 0;
    bottom: -4px;
    height: 1px;
    background-color: #fff;
    transform: scaleX(0);
}
.video-block video { object-fit:contain; }
@media (max-width: 1023px)
{
button.foot-submit-btn { margin-left:6px; font-size:14px; }
}
@media (min-width: 1366px) {
.judges-section--wide .judges-list__item {
    width: 20%;
}
}
