<script>
(function () {
    var form = document.getElementById('js-home-newsletter-form');
    if (!form) return;

    var successEl = form.querySelector('[data-newsletter-success]');
    var errorEl = form.querySelector('[data-newsletter-error]');
    var submitBtn = form.querySelector('button[type="submit"]');

    var errorMessages = {
        '%not-filled%': form.dataset.msgNotFilled,
        '%registered-already%': form.dataset.msgRegisteredAlready
    };

    form.addEventListener('submit', function (e) {
        e.preventDefault();

        successEl.classList.add('hidden');
        errorEl.classList.add('hidden');
        submitBtn.disabled = true;

        form.querySelector('input[name="email2"]').value = form.querySelector('input[name="email"]').value;

        var companyField = form.querySelector('input[name="company"]');
        if (!companyField.value.trim()) {
            companyField.value = '-';
        }

        fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams(new FormData(form)),
            headers: { 'Accept': 'application/json' }
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (data.success) {
                successEl.classList.remove('hidden');
                form.reset();
            } else {
                errorEl.textContent = errorMessages[data.message] || data.message || form.dataset.msgGeneric;
                errorEl.classList.remove('hidden');
            }
        })
        .catch(function () {
            errorEl.textContent = form.dataset.msgNetwork;
            errorEl.classList.remove('hidden');
        })
        .finally(function () {
            submitBtn.disabled = false;
        });
    });
})();
</script>




