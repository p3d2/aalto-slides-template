<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<title>Aalto University Material Bank</title>
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta content="initial-scale=1,user-scalable=no,maximum-scale=1" name="viewport">
	<link rel="apple-touch-icon" href="/core/img/apple-touch-icon.png" />
	<script src="//static.emmi.fi/eerror.js" type="text/javascript"></script>
	<link href="/core/css/login.css?kqvMbG9hSRG" rel="stylesheet">
	<link href="/customer/css/login.css?CprfMnPFn-w" rel="stylesheet">
</head>
<body>
<div class="header">
	
		<div class="language">
			
				<a href="?l=FI">suomi</a>
				
				<a href="?l=SV">svenska</a>
				
		</div>
		
</div>
<div class="main">
	<div class="center">
		<div class="box">
							<div class="logo">
			
								Welcome to Aalto University material bank!
			
			                </div>
			                <div class="welcometext">
			                    <div class="aaltoinfotext">        
			                        <p>The material bank and its contents are for creating official Aalto University communications, branding and marketing materials by<br>
			
			·       the university's communications professionals<br>
			
			·       <b>the university employees</b><br>
			
			·       communications’ subcontractors<br>
			
			·       external cooperators.</p>
			                    </div>
			                    <div class="hakainfo">        
			                        <p>Aalto University personnel use Haka login</p>
			
			                        </p>
			                    </div>  
			                    <p><a href="https://auth.digtator.fi/aalto/emmi/"><img src='../customer/img/haka_logo3.jpg'></a></p>
			                </div>              
			
							<div class="panel login">
								<form name="login" action="" method="post">
									<input type="hidden" name="action" value="login" /> 
			 
									<div class="row">
										<div class="input">
											<input type="text" id="username" name="username" placeholder="Username" autocorrect="off" autocapitalize="off" spellcheck="false" autofocus> 
										</div>
									</div>
									<div class="row">
										<div class="input">
											<input type="password" id="password" name="password" placeholder="Password" autocorrect="off" autocapitalize="off" spellcheck="false"> 
										</div>
									</div>
									<div class="row">
										<div class="input">
											<input class="submit" type="submit" value="Login"> 
										</div>
									</div>
									<div class="row">
										<a href="/forgot">
											Forgot your password? 
										</a>
			
										<a href="/register">
											Register 
										</a>
			 
									</div>
								</form>
								<div class="infoText">
			                        <p><b>Logotypes according to your needs:</b></p>  
			                        <p><a href="https://aaltologo.fi/">Logo generator</a></p>
			                        <p><b>Photos for media representatives:</b></p>
									<p><a href="/l/-M2_f6bbrpxT">Media bank</a></p>
			                    </div>
							</div>
		</div>
	</div>
</div>
</body>
</html>
