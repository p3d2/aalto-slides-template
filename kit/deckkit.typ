// ── deckkit — the tweak layer for Pedro's decks ──────────────────────────────
// One call per slide, all data. The layout lives here so a section file is a
// list of things to change: swap a title, cut a round, rename a figure.
// Nothing brand-related in this file — that is `theme/aalto.typ`, which this
// imports and never overrides. deckkit only composes slides.
//
// HOW TO USE (see decks/<deck>/figs.typ, it is three lines):
//     #import "../../kit/deckkit.typ": make-deck
//     #let d = make-deck(json("figures/manifest.json"))
//     #let fig = d.fig  ... etc
// then in a section file:  #import "../figs.typ": *
//
// FIGURES are referenced by *name*, never by path — `fig("erodium-lines")` —
// because `figures/manifest.json` (generated by `python3 kit/scan-figures.py
// decks/<name>`) knows the extensions. Drop a vector export in, re-scan, the
// slide picks it up; vector wins over raster automatically. An unknown name
// renders a labelled placeholder instead of failing the build, so you can write
// the slide before the picture exists.
//
// KNOBS: `make-deck(manifest, k: (img-h: 6em, reveal: true))` overrides any
// default below, per deck. `show-source: false` hides every credit line for a
// clean rehearsal run.
//
// Typst 0.15 constraints obeyed: no `image(crop:)` (crop in the export), no
// `set raw(inset:)` (the box is drawn around it), `set raw(syntax:/background:)`
// do not exist and `theme: none` does not disable highlighting — so code fences
// here are untagged, and a show rule never applies to its own output.

#import "../theme/aalto.typ": *

#let code-font = ("Source Code Pro", "DejaVu Sans Mono")

// ── neutral deck palette ─────────────────────────────────────────────────
// The grays and inks every deck needs, all from the brand tokens — so a
// section file never invents an rgb() of its own. Roles:
//   fill-card / fill-card-soft   card backgrounds (neutral 3 / neutral 2)
//   line-hair                    hairline dividers (neutral 4)
//   ink-body / ink-muted         secondary / dimmed text (neutral 5 / tint4)
//   ink-emph                     numbers, links, eyebrows on white (blue-2)
// Reserve the deck *accent* (a school colour, one per deck) for highlights:
// active states, badges, section slides — never for structure.
#let fill-card = neutral-colours.at("3")
#let fill-card-soft = neutral-colours.at("2")
#let line-hair = neutral-colours.at("4")
#let ink-body = aalto-gray
#let ink-muted = aalto-gray-light
#let ink-emph = aalto-blue-dark

/// Hairline divider the width of its column.
#let hairline(weight: 0.6pt) = line(length: 100%, stroke: weight + line-hair)

/// `01 / 02 / 03` numbered list item — number in the emphasis ink, bold
/// title, gray description. Separate items with hairline().
#let numbered-item(num, title, desc) = grid(
  columns: (0.9cm, 1fr),
  column-gutter: 0.3em,
  align: top + left,
  block(text(size: 0.7em, weight: "bold", fill: ink-emph)[#num]),
  stack(
    dir: ttb,
    spacing: 0.2em,
    block(text(size: 0.72em, weight: "bold", fill: aalto-black)[#title]),
    v(0.35em),
    block(text(size: 0.6em, fill: ink-body)[#desc]),
  ),
)

/// Sober metric card: one big value + a small note on a neutral card.
#let stat-card(value, note, colour: ink-emph) = box(
  width: 100%,
  fill: fill-card,
  radius: 6pt,
  inset: (x: 0.8em, y: 0.7em),
  stack(
    dir: ttb,
    spacing: 0.25em,
    block(text(size: 1.5em, weight: "bold", fill: colour)[#value]),
    v(0.5em),
    block(text(size: 0.6em, fill: ink-body)[#note]),
  ),
)

/// Small uppercase chip (HPC, GIT, a hostname…). `colour` tints the pale
/// fill and the text (darkened via accent-on-white to stay readable).
#let tag(label, colour: ink-emph) = box(
  fill: colour.lighten(88%),
  radius: 3pt,
  inset: (x: 0.25em, y: 0.15em),
  text(
    size: 0.42em,
    weight: "bold",
    fill: accent-on-white(colour),
    font: code-font,
  )[#label],
)

/// Uppercase eyebrow above a panel title (CULTURE & LITERACY…).
#let eyebrow(label, colour: ink-emph) = text(
  size: 0.43em,
  weight: "bold",
  tracking: 0.06em,
  fill: accent-on-white(colour),
  font: code-font,
)[#label]

/// Bullet with a coloured dot: bold title + dimmed detail.
#let bullet-item(title, detail, colour: ink-emph) = grid(
  columns: (auto, 1fr),
  gutter: 0.4em,
  align: top + left,
  circle(radius: 0.2em, fill: colour, stroke: 0.8pt + colour.darken(20%)),
  stack(
    dir: ttb,
    spacing: 0.4em,
    block(text(size: 0.5em, weight: "bold", fill: aalto-black)[#title]),
    block(text(size: 0.42em, fill: ink-muted)[#detail]),
  ),
)

/// Neutral card panel — the gray box most slides hang their content on.
#let panel(body, fill: fill-card, radius: 6pt, inset: 0.5em, height: auto) = box(
  width: 100%,
  fill: fill,
  radius: radius,
  inset: inset,
  height: height,
  body,
)

/// Build the deck's helper set. `manifest` = the generated figures/manifest.json.
#let make-deck(manifest, k: (:) ) = {
  // ── knobs ────────────────────────────────────────────────────────────────
  let K = (
    fig-h: 3.0in,      // default height of one figure row when a slide does not
                       // say. Typst has NO flex layout (rows: (auto, 1fr) does not
                       // fill a page, tested on 0.15.1), so heights are always
                       // explicit somewhere — the only question is whether you
                       // choose them or a heuristic does.
    // Measured, not guessed: at density "default" the area under the slide
    // heading is 10.4 cm tall (10.5 fits, 11 spills — probed on 0.15.1). Every
    // other density needs its own number; use K.left() and you never hard-code
    // one again.
    body-h: 10.4cm,
    in-ratio: 0.45,    // inputs are drawn at this fraction of the output height.
                       // The rule that makes every before/after slide read the
                       // same: the output is always the biggest thing on it.
    reveal: false,     // true → results/prompt rounds appear on a click
    show-source: true, // false → credit lines hidden (rehearsal)
    prompt-label: [PROMPT],
    answer-label: [AI],
    card-size: 0.74em, // body text size inside prompt/answer cards
  ) + k

  // neutral card palette: the deck accent stays reserved for titles and
  // section slides, so these do not follow it.
  let ink-prompt = aalto-blue-dark
  let ink-ai = aalto-gray
  let fill-prompt = rgb("#EEF3F8")
  let fill-ai = rgb("#F7F7F7")

  // ── figures ─────────────────────────────────────────────────────────────
  /// fig("name") → the picture, or a placeholder naming what is missing.
  /// `w:` fills a column, `h:` makes an equal-height row (letterboxed).
  /// `page:` selects a PDF page (default 1).
  let fig(name, w: auto, h: auto, page: 1, alt: "", fit: "contain") = {
    let entry = manifest.at(name, default: none)
    if entry == none {
      figure-placeholder(
        label: [figure: #name],
        ratio: if h != auto { 4/3 } else { 16/10 },
        fill-colour: aalto-blue,
      )
    } else {
      let path = manifest.at("_dir") + entry.at("file")
      let args = ((alt: alt, fit: fit)
        + (if entry.at("ext") == "pdf" { (page: page) } else { (:) })
        + (if w != auto and h != auto { (width: w, height: h) }
           else if h != auto { (height: h) }
           else if w != auto { (width: w) }
           else { (width: 100%) }))
      image(path, ..args)
    }
  }

  /// A figure with a small gray label under it.
  let cell(name, label: "", w: auto, h: auto, page: 1, alt: "") = block(width: 100%, [
    #align(center)[#fig(name, w: w, h: h, page: page, alt: alt)]
    #v(-0.25em)
    #align(center)[#text(size: 0.6em, fill: aalto-gray, label)]
  ])

// ── text cards ───────────────────────────────────────────────────────────

  /// Real vector paperclip icon (SVG in memory, never looks like a '0').
  let clip-svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#002F6C\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48\"/></svg>"

  /// Attachment chip inside the prompt header.
  /// Pass either:
  ///   - a filename string: "researcher_1.jpg" -> renders [📎 researcher_1.jpg]
  ///   - a manifest key: "researcher-1" -> renders [🖼️ thumbnail + researcher-1]
  ///   - a pair: ("researcher-1", "researcher_1.jpg") -> renders [🖼️ thumbnail + researcher_1.jpg]
  let attach-card(item) = {
    let (fig-name, label) = if type(item) == array { item } else { (item, item) }
    let has-fig = manifest.at(fig-name, default: none) != none
    box(
      inset: (left: if has-fig { 0.25em } else { 0.45em }, right: 0.5em, y: 0.2em),
      radius: 3pt,
      fill: aalto-white,
      stroke: 0.6pt + ink-prompt.transparentize(60%),
      grid(
        columns: (auto, auto),
        column-gutter: 0.35em,
        align: horizon,
        if has-fig {
          box(width: 1.1em, height: 1.1em, radius: 1.5pt, clip: true,
            fig(fig-name, w: 1.1em, h: 1.1em, fit: "cover"))
        } else {
          image(bytes(clip-svg), width: 0.72em, height: 0.72em)
        },
        text(font: code-font, size: 0.62em, weight: "medium", fill: ink-prompt, label),
      )
    )
  }

  /// The thing you type (or a system prompt), as one compact strip.
  /// `attachments:` places file chips cleanly on the right of the PROMPT header bar
  /// (or at the bottom if `attach-pos: "bottom"`).
  let promptline(
    body,
    label: K.prompt-label,
    size: K.card-size,
    attachments: (),
    attach-pos: "header", // "header" (right of PROMPT) | "bottom" (below text)
  ) = block(
    width: 100%,
    fill: fill-prompt,
    stroke: (left: 2.4pt + ink-prompt),
    inset: (left: 0.85em, right: 0.85em, top: 0.38em, bottom: 0.42em),
    above: 0.15em,
    below: 0.15em,
    [
      #set text(size: 0.6em, fill: aalto-black)
      #set par(leading: 0.45em)
      #grid(
        columns: (auto, 1fr),
        align: (left + horizon, right + horizon),
        text(size: 0.68em, weight: "bold", fill: ink-prompt, tracking: 0.09em, label),
        if attach-pos == "header" and attachments.len() > 0 {
          stack(dir: ltr, spacing: 0.35em, ..attachments.map(attach-card))
        }
      )
      #v(-0.2em)
      #body
      #if attach-pos == "bottom" and attachments.len() > 0 {
        v(0.3em)
        stack(dir: ltr, spacing: 0.35em, ..attachments.map(attach-card))
      }
    ],
  )

  /// The thing that comes back.
  let answerline(body, label: K.answer-label, size: K.card-size) = block(
    width: 100%,
    fill: fill-ai,
    stroke: (left: 2.4pt + ink-ai),
    inset: (left: 0.85em, right: 0.85em, top: 0.32em, bottom: 0.36em),
    above: 0.15em,
    below: 0.15em,
    [
      #set text(size: 0.6em, fill: aalto-black)
      #set par(leading: 0.52em)
      #text(size: 0.62em, weight: "bold", fill: ink-ai, tracking: 0.09em, label)
      #v(-0.2em)
      #body
    ],
  )

  /// Annotation pill: what the prompt specifies (Programming language, Tone…).
  let pill(label) = box(
    inset: (x: 0.55em, y: 0.1em),
    radius: 999pt,
    stroke: 0.8pt + ink-prompt,
    fill: aalto-white,
    text(size: 0.56em, weight: "bold", fill: ink-prompt, label),
  )

  let pills(labels) = {
    if labels.len() > 0 {
      block(above: 0.15em, below: 0.1em, {
        for t in labels {
          pill(t)
          h(0.35em)
        }
      })
    }
  }

  /// Style scope for a code fence: wrap an *untagged* ``` block in it.
  let code-block(body) = {
    show raw.where(block: true): it => block(
      width: 100%,
      fill: aalto-white,
      stroke: 0.6pt + rgb("#D8DADD"),
      inset: (x: 0.7em, y: 0.3em),
      above: 0.2em,
      below: 0.1em,
      {
        set text(font: code-font, size: 0.8em, fill: aalto-black)
        it
      },
    )
    body
  }

  /// Inline code (package names, functions, commands).
  let ic(body) = text(font: code-font, size: 0.9em, body)

  /// The one sentence the audience keeps, pinned above the credit line.
  let takeaway(body, colour: aalto-red-dark) = block(
    width: 100%,
    fill: colour.lighten(92%),
    stroke: (left: 2.4pt + colour),
    inset: (left: 0.85em, right: 0.85em, top: 0.35em, bottom: 0.4em),
    above: 0.45em,
    text(size: 0.76em, fill: colour.darken(8%), body),
  )

  /// Weak vs good prompt (the 👎/👍 pair, without the emoji).
  let verdict(ok, body) = block(
    width: 100%,
    above: 0.2em,
    [
      #set text(size: 0.76em)
      #grid(columns: (auto, 1fr), column-gutter: 0.5em, align: left + horizon,
        text(fill: if ok { aalto-blue-dark } else { aalto-red-dark },
          weight: "bold", if ok { [OK] } else { [WEAK] }),
        body)
    ],
  )

  let sidenote(body) = text(size: 0.62em, fill: aalto-gray, body)

  /// Source / attribution line, bottom-aligned with the corner logo. Hidden by
  /// `show-source: false` so a rehearsal deck is clean.
  let credit(body) = {
    if K.show-source { credit-line(body) }
  }

  /// A compact spec table (tools, keywords, system prompts). Hairlines only,
  /// first column in the prompt ink — no Excel grid, no zebra stripes.
  let spec-table(header, rows, cols: (auto, 1fr, 1.25fr), size: 0.66em) = block(
    width: 100%,
    above: 0.3em,
    [
      #set text(size: size, fill: aalto-black)
      #set par(leading: 0.45em, justify: false)
      #table(
        columns: cols,
        inset: (x: 0.5em, y: 0.32em),
        stroke: (x: none, y: 0.5pt + rgb("#DDDEE0")),
        align: left + horizon,
        table.header(
          ..header.map(h => text(weight: "bold", fill: ink-prompt, h))
        ),
        ..rows.flatten(),
      )
    ],
  )

  // ── figure layouts ───────────────────────────────────────────────────────
  /// How much room is left for figures once you say what else is on the slide.
  ///   #shots(("a","b"), h: room(after: 5.6cm))      // prompt strip + captions
  /// Named `room`, never `left` — `left` is Typst's alignment value and shadowing
  /// it breaks `left + horizon` in every file that imports this one.
  /// No measuring, no magic: you add up the strips you put on the slide and this
  /// subtracts from the measured body height. `min:` stops a crowded slide from
  /// collapsing into thumbnails — it is the signal to cut text instead.
  // Exported as `room(...)`, NOT as a K field: Typst refuses `K.room(...)`
  // ("cannot directly call dictionary keys as functions"), and `(K.room)(...)`
  // is not something to write on a slide.
  let room(after: 0cm, min: 3cm) = calc.max(min, K.body-h - after)

  /// ONE image, placed by you, in the deck's caption style. This is the
  /// primitive to reach for when a builder would fight you: `promptline()` at the
  /// top, then whatever figures the slide actually needs.
  /// `alt:` must be a *string* (Typst requires it) — write it when the figure
  /// carries meaning the caption does not.
  let shot(name, caption: none, alt: "", h: auto, w: auto, page: 1) = {
    // Captions are metadata, not a second headline: small, gray, one size for
    // the whole deck. The theme has no figure style, so it lives here.
    show figure.caption: set text(size: 0.58em, fill: aalto-gray)
    show figure.caption: set par(leading: 0.4em)
    figure(
      fig(name, h: h, w: w, page: page, alt: alt),
      caption: if caption != none { caption } else { [] },
      numbering: none,
      kind: "image",
    )
  }

  /// A row (or rows) of shots: names, captions, how many per row. Columns follow
  /// from the count, so adding a third result is one string, not a rewrite.
  let shots(names, captions: (), per-row: auto, h: K.fig-h, gutter: 0.9em, pages: ()) = {
    let cols = if per-row != auto { per-row } else { calc.max(1, names.len()) }
    let items = names.enumerate().map(((i, n)) =>
      shot(n,
        caption: if captions.len() > i { captions.at(i) } else { none },
        h: h,
        page: pages.at(i, default: 1)))
    grid(columns: cols, column-gutter: gutter, row-gutter: 0.6em, align: horizon, ..items)
  }

  let pair(before, after, before-label: [Source], after-label: [AI],
           note: none, h: K.fig-h, page-before: 1, page-after: 1) = grid(
    columns: (1fr, auto, 1fr),
    column-gutter: 0.7em,
    align: horizon,
    cell(before, label: before-label, h: h, page: page-before),
    stack(dir: ttb, spacing: 0.2em,
      align(center, text(size: 1.3em, fill: ink-prompt, sym.arrow.r)),
      if note != none { align(center, text(size: 0.58em, fill: aalto-gray, note)) }),
    cell(after, label: after-label, h: h, page: page-after),
  )

  /// Many small inputs, one big output. This is the shape the old deck never
  /// solved: "here is what I gave it, here is what came back", where the thing
  /// you must look at is the output and the inputs are only context.
  /// Inputs are stacked in a narrow column at `in-ratio` of the output height,
  /// so the hierarchy is the same on every slide of this kind.
  let in-out(inputs, output, out-h: K.fig-h, labels: (), note: none,
             out-label: [result], in-label: none, page-out: 1, pages: ()) = {
    // One input stays small (K.in-ratio); multiple inputs share 82% of out-h
    let total-in-h = if inputs.len() == 1 { out-h * K.in-ratio } else { out-h * 0.82 }
    let in-h = total-in-h / calc.max(1, inputs.len())
    let cells = inputs.enumerate().map(((i, n)) =>
      cell(n,
        label: if labels.len() > i { labels.at(i) } else { "" },
        h: in-h,
        page: pages.at(i, default: 1)))
    let head = if in-label != none {
      (text(size: 0.56em, fill: aalto-gray, in-label),)
    } else {
      ()
    }
    grid(
      columns: (0.55fr, auto, 1.15fr),
      column-gutter: 0.7em,
      align: horizon,
      stack(dir: ttb, spacing: 0.25em, ..head, ..cells),
      stack(dir: ttb, spacing: 0.2em,
        align(center, text(size: 1.3em, fill: ink-prompt, sym.arrow.r)),
        if note != none { align(center, text(size: 0.56em, fill: aalto-gray, note)) } else { none }),
      cell(output, label: out-label, h: out-h, page: page-out),
    )
  }

  /// Equal-weight row of results — comparisons, style ladders, the noise strip.
  let row(images, labels: (), h: K.fig-h, gutter: 0.5em, pages: ()) = {
    ladder(images, labels: labels, h: h, gutter: gutter, pages: pages)
  }

  let ladder(images, labels: (), h: K.fig-h, gutter: 0.5em, pages: ()) = {
    let cells = images.enumerate().map(((i, n)) =>
      cell(n, label: labels.at(i, default: ""), h: h, page: pages.at(i, default: 1)))
    grid(columns: images.len(), column-gutter: gutter, align: horizon, ..cells)
  }

  // ── slide builders ───────────────────────────────────────────────────────
  /// One image slide, from data: prompt strip → figure(s) → lesson → source.
  ///
  ///   #example(
  ///     prompt: [Remove all cables, bottles and chemicals from the image.],
  ///     images: ("lab-before-cleanup", "lab-after-cleanup"),
  ///     labels: ([Your photo], [Emptied]),
  ///     note: [GPT-Image “high fidelity”],
  ///     take: [Editing is the part that is useful in a lab.],
  ///     source: [Old slide 57 · doi:10.5281/zenodo.14032261],
  ///   )
  ///
  /// `mode: auto` picks pair (2 images), single (1) or ladder (3+).
  let example(
    prompt: none,
    prompt-label: K.prompt-label,
    attachments: (),
    images: (),
    labels: (),
    mode: auto,   // auto | single | pair | ladder
    note: none,
    take: none,
    source: none,
    h: auto,      // override the auto-fit for this slide
    reveal: auto,
    pages: (),
  ) = {
    let show-pause = if reveal != auto { reveal } else { K.reveal }
    let kind = if mode != auto { mode }
               else if images.len() == 0 { "none" }   // prompt only: images come
                                                      // later, placed by hand
               else if images.len() == 1 { "single" }
               else if images.len() == 2 { "pair" }
               else { "ladder" }
    // No guessing: the caller says how tall, or gets the deck default.
    let height = if h != auto { h } else { K.fig-h }
    [
      #if show-pause { pause }
      #if prompt != none {
        promptline(prompt, label: prompt-label, attachments: attachments)
      }
      #if kind == "none" {
        // nothing: the slide is text + prompt strip, and the author places the
        // figures with shot()/shots()
      } else if kind == "single" {
        cell(images.at(0), label: labels.at(0, default: ""), h: height,
             page: pages.at(0, default: 1))
      } else if kind == "pair" {
        pair(images.at(0), images.at(1),
             before-label: labels.at(0, default: [Source]),
             after-label: labels.at(1, default: [AI]),
             note: note, h: height,
             page-before: pages.at(0, default: 1),
             page-after: pages.at(1, default: 1))
      } else {
        ladder(images, labels: labels, h: height, pages: pages)
      }
      #if kind != "pair" and kind != "none" and note != none {
        v(0.26em)
        align(center)[#sidenote(note)]
      }
      #if take != none { takeaway(take) }
      #if source != none { credit(source) }
    ]
  }

  /// One prompt-and-answer slide, from data. Each round is a dict:
  ///   (prompt: […], answer: […], tags: ("Tone", "Style"), code: […], note: […])
  /// `reveal` (default on for rounds after the first) puts a `#pause` before
  /// each round, so the audience reads the prompt before the reply.
  let chat-example(
    rounds: (),
    take: none,
    source: none,
    reveal: auto,
  ) = {
    let show-pause = if reveal != auto { reveal } else { K.reveal }
    [
      #for (i, r) in rounds.enumerate() {
        if show-pause and i > 0 { pause }
        pills(r.at("tags", default: ()))
        promptline(r.at("prompt", default: []),attachments: r.at("attachments", default: ()),)
        
        if r.at("answer", default: none) != none {
          answerline(r.at("answer"))
        }
        if r.at("code", default: none) != none {
          code-block(r.at("code"))
        }
        if r.at("note", default: none) != none {
          v(0.15em)
          sidenote(r.at("note"))
        }
      }
      #if take != none { takeaway(take) }
      #if source != none { credit(source) }
    ]
  }

  (
    K: K,
    fig: fig,
    cell: cell,
    pair: pair,
    ladder: ladder,
    shot: shot,
    shots: shots,
    room: room,
    row: row,
    in-out: in-out,
